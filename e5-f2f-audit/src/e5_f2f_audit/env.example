# Copy to `.env` for local/dev runs. bootstrap.load_environment() calls
# load_dotenv() and reads these via os.getenv(...) to construct the collaborators
# directly (no config object). In production, an upstream layer supplies the same
# values and this file is not used.

# ─── AWS Bedrock (ChatBedrockConverse reads standard AWS env vars) ───
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1

# ─── Bedrock model identifiers (inference-profile ARNs or model ids) ───
MODEL_KIMI=moonshotai.kimi-k2.5
MODEL_ANTHROPIC=arn:aws:bedrock:us-east-1:463224243948:inference-profile/us.anthropic.claude-sonnet-4-6

# ─── Bedrock provider names + sampling temperature ───
MODEL_KIMI_PROVIDER=moonshotai
MODEL_ANTHROPIC_PROVIDER=anthropic
MODEL_TEMPERATURE=0.0

# ─── Langfuse v4 ───
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx
LANGFUSE_HOST=https://cloud.langfuse.com

# ─── Orchestration (defaults applied at the entrypoint via os.getenv) ───
ACTIVE_MODEL=kimi                       # kimi | anthropic
CLIENT_NAME=DEFAULT
LOG_LEVEL=INFO                          # DEBUG | INFO | WARNING | ERROR

# ─── Concurrency / rate-limit protection (parallelism stays; caps the peak) ───
MAX_CONCURRENT_AGENTS=5                  # global cap on in-flight Bedrock calls
AGENT_LAUNCH_STAGGER_SECONDS=0.0        # delay between launching each agent call
AGENT_MAX_RETRIES=6                      # retries on throttling (exp. backoff + jitter)
AGENT_RETRY_BASE_DELAY_SECONDS=1.0
AGENT_RETRY_MAX_DELAY_SECONDS=30.0

# ─── Bedrock client tuning (second retry layer + timeouts) ───
BEDROCK_READ_TIMEOUT=1000
BEDROCK_CONNECT_TIMEOUT=60
BEDROCK_MAX_ATTEMPTS=5
BEDROCK_RETRY_MODE=adaptive

# ─── Paths + output sink (all optional; defaults are relative to the repo root) ───
# OCR_MARKDOWN_DIR=ocr-markdown          # input docs: <dir>/<transaction_id>/{POC,F2F}.md
# PROMPTS_DIR=prompts
# SKILLS_DIR=skills
# OUTPUTS_DIR=outputs                    # results tree: <dir>/<transaction_id>/...
# PERSIST_TO_DISK=true                   # false = keep results in memory only
